*.p8
*.p12
*.mobileprovision

# Replit attached assets (may contain sensitive uploads)
attached_assets/*.p8
attached_assets/*.p12
attached_assets/*.key
attached_assets/*.pem
attached_assets/*.mobileprovision

.cursor/rules/nx-rules.mdc
